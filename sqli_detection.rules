
# 1. Basic SQL Injection patterns (SID 1000002-1000003)
drop http any any -> any any (msg:"SQL Injection - Basic Quote Test"; flow:established,to_server; http.uri; pcre:"/(\?|&)([^=]+=)([^&]*['\\\"])/"; flowbits:isnotset,sqli_basic; flowbits:set,sqli_basic; classtype:web-application-attack; sid:1000002; rev:4;)
drop http any any -> any any (msg:"SQL Injection - URI Comment Markers"; flow:established,to_server; http.uri; pcre:"/(\?|&)([^=]+=)([^&]*)(--|#|\/\*)/"; flowbits:isnotset,sqli_basic; flowbits:set,sqli_basic; classtype:web-application-attack; sid:1000003; rev:4;)

# 2. Boolean-based Blind SQL Injection (SID 1000004-1000005)
drop http any any -> any any (msg:"SQL Injection Boolean Blind - AND/OR Condition"; flow:established,to_server; http.uri; pcre:"/\b(AND|OR)\b.{0,40}\b([\d]+)=([\d]+)\b/i"; flowbits:isnotset,sqli_boolean; flowbits:set,sqli_boolean; classtype:web-application-attack; sid:1000004; rev:4;)
drop http any any -> any any (msg:"SQL Injection Boolean Blind - AND/OR Condition POST"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/\b(AND|OR)\b.{0,40}\b([\d]+)=([\d]+)\b/i"; flowbits:isnotset,sqli_boolean; flowbits:set,sqli_boolean; classtype:web-application-attack; sid:1000005; rev:4;)

# 3. Time-based Blind SQL Injection (SID 1000006-1000009)
drop http any any -> any any (msg:"SQL Injection Time-based - SLEEP Function"; flow:established,to_server; http.uri; content:"SLEEP"; nocase; pcre:"/SLEEP\s*\(\s*\d+\s*\)/i"; flowbits:isnotset,sqli_timebased; flowbits:set,sqli_timebased; classtype:web-application-attack; sid:1000006; rev:4;)
drop http any any -> any any (msg:"SQL Injection Time-based - SLEEP Function POST"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"SLEEP"; nocase; pcre:"/SLEEP\s*\(\s*\d+\s*\)/i"; flowbits:isnotset,sqli_timebased; flowbits:set,sqli_timebased; classtype:web-application-attack; sid:1000007; rev:4;)
drop http any any -> any any (msg:"SQL Injection Time-based - PG_SLEEP Function"; flow:established,to_server; http.uri; content:"pg_sleep"; nocase; pcre:"/pg_sleep\s*\(\s*\d+\s*\)/i"; flowbits:isnotset,sqli_timebased; flowbits:set,sqli_timebased; classtype:web-application-attack; sid:1000008; rev:4;)
drop http any any -> any any (msg:"SQL Injection Time-based - WAITFOR DELAY"; flow:established,to_server; http.uri; content:"WAITFOR"; nocase; content:"DELAY"; distance:0; nocase; flowbits:isnotset,sqli_timebased; flowbits:set,sqli_timebased; classtype:web-application-attack; sid:1000009; rev:4;)

# 4. UNION-based SQL Injection (SID 1000010-1000011)
drop http any any -> any any (msg:"SQL Injection UNION-based - UNION SELECT"; flow:established,to_server; http.uri; content:"UNION"; nocase; pcre:"/UNION\s+(ALL\s+)?SELECT\s+/i"; flowbits:isnotset,sqli_union; flowbits:set,sqli_union; classtype:web-application-attack; sid:1000010; rev:4;)
drop http any any ->s any any (msg:"SQL Injection UNION-based - UNION SELECT POST"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"UNION"; nocase; pcre:"/UNION\s+(ALL\s+)?SELECT\s+/i"; flowbits:isnotset,sqli_union; flowbits:set,sqli_union; classtype:web-application-attack; sid:1000011; rev:4;)

# 5. Error-based SQL Injection (SID 1000012-1000013)
drop http any any -> any any (msg:"SQL Injection Error-based - EXTRACTVALUE"; flow:established,to_server; http.uri; content:"EXTRACTVALUE"; nocase; pcre:"/EXTRACTVALUE\s*\(\s*\d+\s*,\s*.*?\)/i"; flowbits:isnotset,sqli_error; flowbits:set,sqli_error; classtype:web-application-attack; sid:1000012; rev:4;)
drop http any any -> any any (msg:"SQL Injection Error-based - CONCAT 0x7e"; flow:established,to_server; http.uri; content:"CONCAT"; nocase; content:"0x7e"; distance:0; within:100; nocase; flowbits:isnotset,sqli_error; flowbits:set,sqli_error; classtype:web-application-attack; sid:1000013; rev:4;)

# 6. URL Encoded Payload Detection (SID 1000014)
drop http any any -> any any (msg:"SQL Injection URL Encoded Payload"; flow:established,to_server; http.uri.raw; pcre:"/%27|%22|%2D%2D|%23|%2F%2A|%2A%2F/i"; flowbits:isnotset,sqli_encoded; flowbits:set,sqli_encoded; classtype:web-application-attack; sid:1000014; rev:4;)

# 7. Database Fingerprinting (SID 1000015-1000017)
drop http any any -> any any (msg:"SQL Injection Fingerprint - MySQL @@version"; flow:established,to_server; http.uri; content:"@@version"; nocase; flowbits:isnotset,sqli_fingerprint; flowbits:set,sqli_fingerprint; classtype:web-application-attack; sid:1000015; rev:4;)
drop http any any -> any any (msg:"SQL Injection Fingerprint - PostgreSQL version()"; flow:established,to_server; http.uri; content:"version()"; nocase; flowbits:isnotset,sqli_fingerprint; flowbits:set,sqli_fingerprint; classtype:web-application-attack; sid:1000016; rev:4;)
drop http any any -> any any (msg:"SQL Injection Fingerprint - SQL Server @@SERVERNAME"; flow:established,to_server; http.uri; content:"@@SERVERNAME"; nocase; flowbits:isnotset,sqli_fingerprint; flowbits:set,sqli_fingerprint; classtype:web-application-attack; sid:1000017; rev:4;)

# 8. ORDER BY Column Enumeration (SID 1000018)
