# 9. NULL Byte Injection (SID 1000019)
drop http any any -> any any (msg:"SQL Injection - NULL Byte Injection"; flow:established,to_server; http.uri.raw; content:"%00"; flowbits:isnotset,sqli_nullbyte; flowbits:set,sqli_nullbyte; classtype:web-application-attack; sid:1000019; rev:4;)

# 10. Database Function Calls (SID 1000020-1000021)
drop http any any -> any any (msg:"SQL Injection - User Info Function Call"; flow:established,to_server; http.uri; pcre:"/CURRENT_USER\(\)|USER\(\)|SESSION_USER\(\)/i"; flowbits:isnotset,sqli_dbfunc; flowbits:set,sqli_dbfunc; classtype:web-application-attack; sid:1000020; rev:4;)
drop http any any -> any any (msg:"SQL Injection - Database Info Function Call"; flow:established,to_server; http.uri; pcre:"/DATABASE\(\)|SCHEMA\(\)/i"; flowbits:isnotset,sqli_dbfunc; flowbits:set,sqli_dbfunc; classtype:web-application-attack; sid:1000021; rev:4;)

# 11. Hex Encoding Detection (SID 1000023)
drop http any any -> any any (msg:"SQL Injection - Hex Encoded Value"; flow:established,to_server; http.uri; pcre:"/[\?&][^&=]*=.*0x[0-9a-f]{2,}/i"; flowbits:isnotset,sqli_hex; flowbits:set,sqli_hex; classtype:web-application-attack; sid:1000023; rev:4;)

# 12. File System Access (SID 1000024)
